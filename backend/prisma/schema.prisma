// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PropertyStatus {
  PENDING
  APPROVED
  REJECTED
  SOLD
}

enum ProjectStatus {
  ONGOING
  COMPLETED
}

enum LeadType {
  BUY
  RENT
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  email        String   @unique
  phone        String?
  location     String?
  passwordHash String
  resetToken   String?
  resetTokenExpiry DateTime?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model Property {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  price       Float
  location    String
  city        String?
  state       String?
  country     String?
  status      PropertyStatus @default(PENDING)
  mediaUrls   String[]
  ownerId     String         @db.ObjectId
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([city, state])
  @@index([createdAt])
  @@map("properties")
}

model Inquiry {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  message    String
  propertyId String   @db.ObjectId
  buyerId    String?  @db.ObjectId
  status     String   @default("open")
  createdAt  DateTime @default(now())

  @@index([propertyId])
  @@index([buyerId])
  @@map("inquiries")
}

model NotificationLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String?  @db.ObjectId
  channel    String
  status     String
  detail     String?
  createdAt  DateTime @default(now())

  @@index([propertyId, channel])
  @@map("notification_logs")
}

model Blog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  content     String
  excerpt     String?
  authorId    String   @db.ObjectId
  published   Boolean  @default(false)
  featuredImage String?
  tags        String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, createdAt])
  @@index([authorId])
  @@map("blogs")
}

model Project {
  id                 String        @id @default(auto()) @map("_id") @db.ObjectId
  title              String
  description        String
  price              Float?
  status             ProjectStatus @default(ONGOING)
  location           String?
  imageUrls          String[]
  startDateLabel     String?
  expectedCompletion String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
  @@map("projects")
}

model Lead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  propertyId String   @db.ObjectId
  type       LeadType
  name       String
  email      String
  phone      String
  message    String?
  createdAt  DateTime @default(now())

  @@index([propertyId, type, createdAt])
  @@map("leads")
}
