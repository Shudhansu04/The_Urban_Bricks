DATABASE_URL="mongodb://localhost:27017/property_db"
PORT=4000
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="change_me"

# Resend (RECOMMENDED for production - works on Render, no SMTP blocking)
# Get API key: https://resend.com/api-keys
# Free tier: 3000 emails/month
RESEND_API_KEY="re_xxxxxxxxxxxx"

# Admin Email (where notifications are sent)
ADMIN_EMAIL="admin@example.com"

# Nodemailer SMTP (optional - for local dev; Gmail often times out on Render)
# For Gmail: Use App Password - Google Account > Security > App passwords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="your-email@gmail.com"
ADMIN_PASSWORD="admin123"

# Twilio WhatsApp Configuration
TWILIO_ACCOUNT_SID="your_twilio_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
ADMIN_WHATSAPP_TO="whatsapp:+911234567890"

NODE_ENV="development"